{
  "permissions": {
    "allow": [
      "Bash(python scripts/generate_ee_questionnaire.py)",
      "Bash(python -c ':*)",
      "Bash(npx drizzle-kit *)",
      "Bash(npx vitest *)",
      "Bash(npx tsc *)",
      "Bash(gh pr merge *)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Write|Edit|Bash",
        "hooks": [
          {
            "type": "command",
            "command": "python \"${CLAUDE_PROJECT_DIR}/.claude/hooks/secrets_blocker.py\"",
            "timeout": 10,
            "statusMessage": "Scanning for secrets..."
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "python \"${CLAUDE_PROJECT_DIR}/.claude/hooks/bash_audit.py\" || true",
            "async": true
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python \"${CLAUDE_PROJECT_DIR}/.claude/hooks/rtk_gain_hook.py\" 2>/dev/null || true",
            "timeout": 15,
            "statusMessage": "Fetching RTK savings..."
          }
        ]
      }
    ]
  },
  "disabledMcpjsonServers": [
    "playwright"
  ]
}
