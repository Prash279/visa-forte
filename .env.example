# .env.local — Visa Forte Platform
# This file contains your local secrets. NEVER commit this to GitHub.
# Fill in each value as you set up each service.

# ─── Application ─────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ─── Database ─────────────────────────────────────────────────────────────────
# Fill in when Render gives you a PostgreSQL connection string
DATABASE_URL=

# ─── Authentication (Better Auth) ─────────────────────────────────────────────
# Generate a secret at: https://generate-secret.vercel.app
BETTER_AUTH_SECRET=

# ─── Payments (Razorpay — the only rail) ──────────────────────────────────────
# Dashboard → Settings → API Keys. Use test keys (rzp_test_*) locally.
# KEY_ID is public and sent to the browser; KEY_SECRET is server-side only.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# ─── Storage (Cloudflare R2) ──────────────────────────────────────────────────
CLOUDFLARE_R2_ACCESS_KEY_ID=
CLOUDFLARE_R2_SECRET_ACCESS_KEY=
CLOUDFLARE_R2_BUCKET_NAME=
CLOUDFLARE_R2_ACCOUNT_ID=
CLOUDFLARE_R2_PUBLIC_URL=

# ─── AI Layer (Anthropic Claude) ──────────────────────────────────────────────
# Server-side only. Get from: console.anthropic.com
ANTHROPIC_API_KEY=

# ─── Email Delivery ───────────────────────────────────────────────────────────
# Google Workspace SMTP, used only by apps/web/src/lib/email.ts.
# SMTP_USER is the mailbox that sends AND the From address. Use a dedicated
# mailbox, not prashant@: Gmail files mail sent to yourself under Sent only,
# so admin alerts would never reach the inbox.
# SMTP_APP_PASSWORD: Google Account -> Security -> 2-Step Verification -> App passwords.
SMTP_USER=
SMTP_APP_PASSWORD=

# ─── Observability (Sentry) ───────────────────────────────────────────────────
SENTRY_DSN=

# ─── FastAPI Backend ──────────────────────────────────────────────────────────
APP_ENV=development
